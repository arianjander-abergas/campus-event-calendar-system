# Copy this file to .env (same folder) and fill it in. .env is not committed.

# The live address of the site (no slash at the end).
APP_ORIGIN=https://your-domain.com

# Optional: the Event Hub Assistant and email notifications.
# (config/*.local.php are not copied into the images: set them here.)
ANTHROPIC_API_KEY=
SMTP_USERNAME=
SMTP_PASSWORD=
